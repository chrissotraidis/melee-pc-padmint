diff --git a/src/pc/card_comment.c b/src/pc/card_comment.c
new file mode 100644
index 0000000..f7e45df
--- /dev/null
+++ b/src/pc/card_comment.c
@@ -0,0 +1,9 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#include "card_comment.h"
+
+#include <stdio.h>
+
+int pc_card_format_comment(
+    char* comment, size_t capacity, const char* title, int year, int month, int day) {
+    return snprintf(comment, capacity, "%s %4d/%02d/%02d", title, year, month, day);
+}
diff --git a/src/pc/card_comment.h b/src/pc/card_comment.h
new file mode 100644
index 0000000..4707605
--- /dev/null
+++ b/src/pc/card_comment.h
@@ -0,0 +1,12 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#ifndef PC_CARD_COMMENT_H
+#define PC_CARD_COMMENT_H
+
+#include <stddef.h>
+
+/* Keep the game/platform boundary non-variadic: the iOS game compiler uses
+ * the generic AArch64 ABI, while Apple's libc expects stack-based varargs. */
+int pc_card_format_comment(
+    char* comment, size_t capacity, const char* title, int year, int month, int day);
+
+#endif
diff --git a/tools/test_card_comment.c b/tools/test_card_comment.c
new file mode 100644
index 0000000..6d35cc2
--- /dev/null
+++ b/tools/test_card_comment.c
@@ -0,0 +1,33 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#include "pc/card_comment.h"
+
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+
+int main(void) {
+    struct {
+        char comment[64];
+        unsigned char guard;
+    } output = {{0}, 0xA5};
+    const char* english = "Super Smash Bros. Melee         Game Data";
+    const char* japanese =
+        "\x91\xe5\x97\x90\x93\xac\x83\x58\x83\x7d\x83\x62\x83\x56\x83\x85\x83\x75\x83\x89\x83\x55"
+        "\x81\x5b\x83\x59\x82\x63\x82\x77\x20\x20\x83\x5a\x81\x5b\x83\x75\x83\x66\x81\x5b\x83\x5e";
+    int count =
+        pc_card_format_comment(output.comment, sizeof(output.comment), english, 2026, 10, 27);
+    assert(count == 52);
+    assert(strcmp(output.comment, "Super Smash Bros. Melee         Game Data 2026/10/27") == 0);
+    assert(output.guard == 0xA5);
+    count = pc_card_format_comment(output.comment, sizeof(output.comment), japanese, 2026, 1, 2);
+    assert(count == 55);
+    assert(memcmp(output.comment, japanese, strlen(japanese)) == 0);
+    assert(strcmp(output.comment + strlen(japanese), " 2026/01/02") == 0);
+    assert(output.guard == 0xA5);
+    char short_buffer[8];
+    count = pc_card_format_comment(short_buffer, sizeof(short_buffer), english, 2026, 10, 27);
+    assert(count == 52);
+    assert(strcmp(short_buffer, "Super S") == 0);
+    puts("PASS: save comments, date padding, capacity and adjacent guard");
+    return 0;
+}
